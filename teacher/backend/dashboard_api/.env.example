# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=*

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database / Prisma Connection
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Secret
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
