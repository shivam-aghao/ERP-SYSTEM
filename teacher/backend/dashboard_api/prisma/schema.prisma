// Prisma schema for SSGMCE Teacher Dashboard ERP
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  code         String    @id
  name         String
  icon         String?   @default("laptop")
  description  String?
  headOfDept   String?   @map("head_of_dept")
  classesCount Int?      @default(0) @map("classes_count")
  createdAt    DateTime? @default(now()) @map("created_at")

  faculty      Faculty[]
  classes      Class[]
  students     Student[]
  attendanceSessions AttendanceSession[]

  @@map("departments")
}

model Faculty {
  id             String    @id @default(uuid()) @db.Uuid
  authUserId     String?   @unique @map("auth_user_id") @db.Uuid
  employeeId     String    @unique @map("employee_id")
  name           String
  prefix         String?   @default("Prof.")
  title          String
  departmentCode String    @map("department_code")
  email          String    @unique
  phone          String?
  avatarInitials String?   @map("avatar_initials")
  cabinLocation  String?   @map("cabin_location")
  officeHours    String?   @map("office_hours")
  qualification  String?
  isActive       Boolean?  @default(true) @map("is_active")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at")

  department     Department @relation(fields: [departmentCode], references: [code])
  subjects       Subject[]
  attendanceSessions AttendanceSession[]
  markedAttendanceRecords AttendanceRecord[] @relation("MarkedByFaculty")
  timetable      Timetable[]
  syllabusProgress SyllabusProgress[]
  resultsUploaded Result[] @relation("UploadedByFaculty")
  notifications  Notification[]
  activityLogs   ActivityLog[]

  @@map("faculty")
}

model Class {
  code           String    @id
  departmentCode String    @map("department_code")
  name           String
  semester       String
  studentsCount  Int?      @default(0) @map("students_count")
  room           String?
  academicYear   String    @map("academic_year")
  createdAt      DateTime? @default(now()) @map("created_at")

  department     Department @relation(fields: [departmentCode], references: [code])
  subjects       Subject[]
  students       Student[]
  attendanceSessions AttendanceSession[]
  timetable      Timetable[]
  syllabusProgress SyllabusProgress[]

  @@map("classes")
}

model Subject {
  code        String    @id
  name        String
  classCode   String    @map("class_code")
  facultyId   String?   @map("faculty_id") @db.Uuid
  credits     String?   @default("4 Credits")
  icon        String?   @default("book-open")
  lectureTime String?   @map("lecture_time")
  semester    String?
  createdAt   DateTime? @default(now()) @map("created_at")

  class       Class     @relation(fields: [classCode], references: [code], onDelete: Cascade)
  faculty     Faculty?  @relation(fields: [facultyId], references: [id])
  attendanceSessions AttendanceSession[]
  timetable   Timetable[]
  syllabusProgress SyllabusProgress[]
  results     Result[]

  @@map("subjects")
}

model Student {
  id             String    @id @default(uuid()) @db.Uuid
  rollNo         Int       @map("roll_no")
  rollFormatted  String    @map("roll_formatted")
  enrollmentNo   String    @unique @map("enrollment_no")
  name           String
  email          String?   @unique
  classCode      String    @map("class_code")
  departmentCode String    @map("department_code")
  phone          String?
  guardianName   String?   @map("guardian_name")
  guardianPhone  String?   @map("guardian_phone")
  isActive       Boolean?  @default(true) @map("is_active")
  createdAt      DateTime? @default(now()) @map("created_at")

  class          Class      @relation(fields: [classCode], references: [code], onDelete: Cascade)
  department     Department @relation(fields: [departmentCode], references: [code])
  attendanceRecords AttendanceRecord[]
  results        Result[]

  @@unique([classCode, rollNo])
  @@map("students")
}

model AttendanceSession {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @unique @map("session_id")
  facultyId      String    @map("faculty_id") @db.Uuid
  classCode      String    @map("class_code")
  subjectCode    String    @map("subject_code")
  departmentCode String    @map("department_code")
  lectureDate    DateTime  @map("lecture_date") @db.Date
  lectureTime    String    @map("lecture_time")
  markingMode    String?   @default("swipe") @map("marking_mode")
  totalStudents  Int       @map("total_students")
  presentCount   Int?      @default(0) @map("present_count")
  absentCount    Int?      @default(0) @map("absent_count")
  attendanceRate Decimal?  @default(0) @map("attendance_rate") @db.Decimal(5, 2)
  status         String?   @default("draft")
  isDraftSaved   Boolean?  @default(false) @map("is_draft_saved")
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at")

  faculty        Faculty    @relation(fields: [facultyId], references: [id])
  class          Class      @relation(fields: [classCode], references: [code])
  subject        Subject    @relation(fields: [subjectCode], references: [code])
  department     Department @relation(fields: [departmentCode], references: [code])
  records        AttendanceRecord[]

  @@unique([lectureDate, classCode, subjectCode, lectureTime])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  rollNo    Int       @map("roll_no")
  status    String
  markedAt  DateTime? @default(now()) @map("marked_at")
  markedBy  String?   @map("marked_by") @db.Uuid
  remarks   String?

  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty   Faculty?          @relation("MarkedByFaculty", fields: [markedBy], references: [id])

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model Timetable {
  id           String    @id @default(uuid()) @db.Uuid
  facultyId    String    @map("faculty_id") @db.Uuid
  dayOfWeek    Int       @map("day_of_week")
  slotIndex    Int       @map("slot_index")
  subjectCode  String?   @map("subject_code")
  classCode    String?   @map("class_code")
  room         String?
  isLab        Boolean?  @default(false) @map("is_lab")
  academicYear String    @map("academic_year")
  createdAt    DateTime? @default(now()) @map("created_at")

  faculty      Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject      Subject?  @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  class        Class?    @relation(fields: [classCode], references: [code], onDelete: Cascade)

  @@unique([facultyId, dayOfWeek, slotIndex, academicYear])
  @@map("timetable")
}

model SyllabusProgress {
  id                String    @id @default(uuid()) @db.Uuid
  subjectCode       String    @map("subject_code")
  classCode         String    @map("class_code")
  facultyId         String    @map("faculty_id") @db.Uuid
  unitNumber        Int       @map("unit_number")
  unitName          String    @map("unit_name")
  completionPercent Int?      @default(0) @map("completion_percent")
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at")

  subject           Subject   @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  class             Class     @relation(fields: [classCode], references: [code], onDelete: Cascade)
  faculty           Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([subjectCode, classCode, unitNumber])
  @@map("syllabus_progress")
}

model Result {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  subjectCode    String    @map("subject_code")
  assessmentType String    @map("assessment_type")
  marksObtained  Decimal?  @map("marks_obtained") @db.Decimal(5, 2)
  maxMarks       Decimal?  @map("max_marks") @db.Decimal(5, 2)
  academicYear   String    @map("academic_year")
  semester       String?
  uploadedBy     String?   @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime? @default(now()) @map("uploaded_at")

  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject   @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  faculty        Faculty?  @relation("UploadedByFaculty", fields: [uploadedBy], references: [id])

  @@unique([studentId, subjectCode, assessmentType, academicYear])
  @@map("results")
}

model Notification {
  id                 String    @id @default(uuid()) @db.Uuid
  recipientFacultyId String?   @map("recipient_faculty_id") @db.Uuid
  title              String
  description        String?
  icon               String?   @default("bell")
  type               String?   @default("info")
  isRead             Boolean?  @default(false) @map("is_read")
  actionUrl          String?   @map("action_url")
  createdAt          DateTime? @default(now()) @map("created_at")

  faculty            Faculty?  @relation(fields: [recipientFacultyId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ActivityLog {
  id           String    @id @default(uuid()) @db.Uuid
  facultyId    String?   @map("faculty_id") @db.Uuid
  activityType String    @map("activity_type")
  title        String
  description  String?
  icon         String?   @default("activity")
  iconStyle    String?   @default("blue") @map("icon_style")
  metadata     Json?     @default("{}")
  createdAt    DateTime? @default(now()) @map("created_at")

  faculty      Faculty?  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model AcademicTerm {
  id           String    @id @default(uuid()) @db.Uuid
  academicYear String    @map("academic_year")
  semesterType String    @map("semester_type")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  isCurrent    Boolean?  @default(false) @map("is_current")
  createdAt    DateTime? @default(now()) @map("created_at")

  @@map("academic_terms")
}

