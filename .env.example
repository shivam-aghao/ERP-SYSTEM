# SSGMCE UNIFIED COLLEGE ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this template to .env in your root directory:
#    cp .env.example .env
# 2. Fill in the required credentials below for your local or cloud environment.
# 3. NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# Server Configuration
PORT=8000
PROJECT_NAME="SSGMCE College ERP Unified System"
VERSION="2.0.0"

# PostgreSQL Database Connection (Server-Only)
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# Supabase Project Endpoints
SUPABASE_URL=

# Supabase Public Client Key (Used by client-side browser SDKs with RLS)
SUPABASE_ANON_KEY=

# Supabase Server-Only Secret Keys (CRITICAL: NEVER EXPOSE TO FRONTEND OR BROWSER)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Public Frontend Client Keys (Optional publishable identifiers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

