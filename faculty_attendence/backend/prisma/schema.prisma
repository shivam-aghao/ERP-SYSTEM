datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  HOD
  ADMIN
  TA
}

enum SubjectType {
  THEORY
  LAB
  TUTORIAL
}

enum SessionType {
  REGULAR
  EXTRA
  PRACTICAL
}

enum SessionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  UNMARKED
}

model User {
  id             String   @id @default(uuid())
  employeeCode   String   @unique @map("employee_code")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  fullName       String   @map("full_name")
  role           Role     @default(TEACHER)
  departmentId   String?  @map("department_id")
  designation    String?
  phone          String?
  avatarInitials String?  @map("avatar_initials")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  department     Department?          @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  headedDept     Department?          @relation("DeptHOD")
  classSubjects  ClassSubject[]
  classCards     ClassCard[]
  sessions       AttendanceSession[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. "CSE", "IT", "MECH"
  name      String   // e.g. "Computer Science & Engineering"
  hodUserId String?  @unique @map("hod_user_id")
  createdAt DateTime @default(now()) @map("created_at")

  hodUser    User?        @relation("DeptHOD", fields: [hodUserId], references: [id], onDelete: SetNull)
  users      User[]       @relation("UserDepartment")
  classes    Class[]
  subjects   Subject[]
  classCards ClassCard[]

  @@map("departments")
}

model Class {
  id           String   @id @default(uuid())
  departmentId String   @map("department_id")
  name         String   // e.g. "SY-CSE-A", "2R1"
  year         Int      // 1, 2, 3, 4
  division     String   // "A", "B", "1", "2"
  semester     Int      // 1 to 8
  strength     Int      @default(60)
  createdAt    DateTime @default(now()) @map("created_at")

  department    Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students      Student[]
  classSubjects ClassSubject[]
  classCards    ClassCard[]
  sessions      AttendanceSession[]
  histories     AttendanceHistorySummary[]

  @@map("classes")
}

model Subject {
  id           String      @id @default(uuid())
  code         String      @unique // e.g. "3CS205MD"
  name         String      // e.g. "Database Management"
  departmentId String      @map("department_id")
  semester     Int
  type         SubjectType @default(THEORY)
  credits      Int         @default(3)

  department    Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]
  classCards    ClassCard[]
  sessions      AttendanceSession[]
  histories     AttendanceHistorySummary[]

  @@map("subjects")
}

model ClassSubject {
  id           String   @id @default(uuid())
  classId      String   @map("class_id")
  subjectId    String   @map("subject_id")
  teacherId    String   @map("teacher_id")
  academicYear String   @default("2025-2026") @map("academic_year")
  isActive     Boolean  @default(true) @map("is_active")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId, teacherId, academicYear])
  @@map("class_subjects")
}

model ClassCard {
  id           String   @id @default(uuid())
  teacherId    String   @map("teacher_id")
  departmentId String   @map("department_id")
  classId      String   @map("class_id")
  subjectId    String   @map("subject_id")
  createdAt    DateTime @default(now()) @map("created_at")

  teacher    User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, departmentId, classId, subjectId])
  @@index([teacherId])
  @@map("class_cards")
}

model Student {
  id            String   @id @default(uuid())
  studentCode   String   @unique @map("student_code")
  rollNo        Int      @map("roll_no")
  fullName      String   @map("full_name")
  classId       String   @map("class_id")
  isProvisional Boolean  @default(false) @map("is_provisional")
  email         String?
  phone         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  class             Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  histories         AttendanceHistorySummary[]

  @@index([classId])
  @@map("students")
}

model AttendanceSession {
  id               String        @id @default(uuid())
  teacherId        String        @map("teacher_id")
  classId          String        @map("class_id")
  subjectId        String        @map("subject_id")
  sessionDate      DateTime      @map("session_date") @db.Date
  periodNo         Int           @default(1) @map("period_no")
  startTime        String?       @map("start_time")
  endTime          String?       @map("end_time")
  sessionType      SessionType   @default(REGULAR) @map("session_type")
  topicTaught      String?       @map("topic_taught")
  additionalTopics String?       @map("additional_topics")
  remark           String?
  status           SessionStatus @default(DRAFT)
  totalStudents    Int           @default(0) @map("total_students")
  presentCount     Int           @default(0) @map("present_count")
  absentCount      Int           @default(0) @map("absent_count")
  attendanceRate   Float         @default(0.0) @map("attendance_rate")
  submittedAt      DateTime?     @map("submitted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  teacher User               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([classId, subjectId, sessionDate, periodNo])
  @@index([sessionDate, classId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  studentId String           @map("student_id")
  status    AttendanceStatus @default(UNMARKED)
  markedAt  DateTime         @default(now()) @map("marked_at")

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@map("attendance_records")
}

model AttendanceHistorySummary {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  classId        String   @map("class_id")
  subjectId      String   @map("subject_id")
  last10Statuses String   @default("") @map("last_10_statuses") @db.VarChar(10)
  updatedAt      DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@map("attendance_history_summary")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
