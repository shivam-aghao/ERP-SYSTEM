{
  "info": {
    "name": "SSGMCE Faculty Attendance API",
    "description": "Postman Collection for SSGMCE Faculty Attendance ERP Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Departments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/departments"
      }
    },
    {
      "name": "Class Cards",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/cards"
      }
    },
    {
      "name": "Students Roster",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/students/class/2R1"
      }
    },
    {
      "name": "Attendance - Check Duplicate",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/attendance/check-duplicate"
      }
    },
    {
      "name": "Attendance - Submit",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/attendance/submit"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ]
}
