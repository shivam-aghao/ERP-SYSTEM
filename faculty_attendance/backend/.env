# Node environment (development | production | test)
NODE_ENV=development
PORT=5000

# Client origin for CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# PostgreSQL Connection String (Prisma format)
DATABASE_URL=postgresql://erp_admin:erp_secret_pass@localhost:5432/ssgmce_erp?schema=public

# JWT Secrets and Expiration
JWT_SECRET=ssgmce_super_secure_jwt_access_secret_key_2026_x94j2!
JWT_REFRESH_SECRET=ssgmce_super_secure_jwt_refresh_secret_key_2026_q83m7!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis connection (optional, falls back gracefully if unavailable)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
